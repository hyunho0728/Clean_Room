<Window x:Class="Clean_Room.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helix="http://helix-toolkit.org/wpf"
        Title="클린룸 모니터링 시스템 - 관리자"
        WindowStartupLocation="CenterScreen"
        Background="#0A0F1E"
        Width="1400" Height="720"
        MinWidth="900" MinHeight="500">

    <Window.Resources>
        <!-- 클린룸 선택 토글 버튼 스타일 -->
        <Style x:Key="RoomSelectBtn" TargetType="ToggleButton">
            <Setter Property="Width"    Value="44"/>
            <Setter Property="Height"   Value="24"/>
            <Setter Property="Margin"   Value="4,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor"   Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="#0D2035" BorderBrush="#334155"
                                BorderThickness="1" CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="lbl" Text="{TemplateBinding Content}"
                                       Foreground="#64748B" FontSize="11" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd"  Property="Background"  Value="#0A2535"/>
                                <Setter TargetName="bd"  Property="BorderBrush" Value="#22D3EE"/>
                                <Setter TargetName="lbl" Property="Foreground"  Value="#22D3EE"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E3A5F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 클린룸1 아이콘 버튼 스타일 -->
        <Style x:Key="IconBtn1" TargetType="Button">
            <Setter Property="Focusable"       Value="False"/>
            <Setter Property="Width"           Value="52"/>
            <Setter Property="Height"          Value="58"/>
            <Setter Property="Margin"          Value="4,0"/>
            <Setter Property="Background"      Value="#0D2035"/>
            <Setter Property="BorderBrush"     Value="#1E3A5F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E3A5F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#22D3EE22"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 레이어 토글 — 클린룸 1 (청록 테마) -->
        <Style x:Key="LayerBtn1" TargetType="ToggleButton">
            <Setter Property="Height"   Value="17"/>
            <Setter Property="Padding"  Value="7,0"/>
            <Setter Property="Margin"   Value="2,0"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Cursor"   Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="#122030" BorderBrush="#22D3EE"
                                BorderThickness="1" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="lbl" Text="{TemplateBinding Content}"
                                       Foreground="#22D3EE" FontSize="9" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="bd"  Property="Background"   Value="#0A0F1E"/>
                                <Setter TargetName="bd"  Property="BorderBrush"  Value="#1E3A5F"/>
                                <Setter TargetName="lbl" Property="Foreground"   Value="#2A4060"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A3045"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 레이어 토글 — 클린룸 2 (퍼플 테마) -->
        <Style x:Key="LayerBtn2" TargetType="ToggleButton">
            <Setter Property="Height"   Value="17"/>
            <Setter Property="Padding"  Value="7,0"/>
            <Setter Property="Margin"   Value="2,0"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Cursor"   Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="#16102A" BorderBrush="#818CF8"
                                BorderThickness="1" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="lbl" Text="{TemplateBinding Content}"
                                       Foreground="#818CF8" FontSize="9" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="bd"  Property="Background"   Value="#0A0F1E"/>
                                <Setter TargetName="bd"  Property="BorderBrush"  Value="#2D1B5E"/>
                                <Setter TargetName="lbl" Property="Foreground"   Value="#2A1A50"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E1540"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 클린룸2 관리자 장비 지시 버튼 -->
        <Style x:Key="CR2EqBtn" TargetType="Button">
            <Setter Property="Height"          Value="26"/>
            <Setter Property="Margin"          Value="2,2"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Background"      Value="#100A24"/>
            <Setter Property="BorderBrush"     Value="#4C3A9E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"      Value="#A78BFA"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background"  Value="#08061A"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#1E1540"/>
                                <Setter Property="Foreground" Value="#2A1A50"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2D1B5E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#A78BFA33"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 클린룸2 아이콘 버튼 스타일 -->
        <Style x:Key="IconBtn2" TargetType="Button">
            <Setter Property="Focusable"       Value="False"/>
            <Setter Property="Width"           Value="52"/>
            <Setter Property="Height"          Value="58"/>
            <Setter Property="Margin"          Value="4,0"/>
            <Setter Property="Background"      Value="#120D2A"/>
            <Setter Property="BorderBrush"     Value="#2D1B5E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2D1B5E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#818CF822"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 웨이퍼 배너 확인 버튼 템플릿 (코드비하인드에서 FindResource로 참조) -->
        <ControlTemplate x:Key="WaferConfirmBtnTemplate" TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="8,0">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <Grid Grid.Row="0" Background="#0D1526">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0">
                <TextBlock Text="■ CLEANROOM" FontSize="18" FontWeight="Bold"
                           Foreground="#22D3EE" VerticalAlignment="Center"/>
                <TextBlock Text="MONITORING SYSTEM" FontSize="18"
                           Foreground="#FFFFFF" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBlock x:Name="txtAdminName" FontSize="13"
                           Foreground="#6B7280" VerticalAlignment="Center" Margin="24,0,0,0"/>
                <!-- 클린룸 선택 토글 -->
                <Border Margin="28,0,0,0" Background="#070E1A" BorderBrush="#1E3A5F"
                        BorderThickness="1" CornerRadius="14" Padding="8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="표시" Foreground="#475569" FontSize="10"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ToggleButton x:Name="tglShowCR1" Visibility="Collapsed" IsChecked="False"
                                      Style="{StaticResource RoomSelectBtn}" Click="TglShowRoom_Click"/>
                        <ToggleButton x:Name="tglShowCR3" Content="CR1" IsChecked="True"
                                      Style="{StaticResource RoomSelectBtn}" Click="TglShowRoom_Click"/>
                        <ToggleButton x:Name="tglShowCR2" Content="CR2" IsChecked="True"
                                      Style="{StaticResource RoomSelectBtn}" Click="TglShowRoom_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <Button Grid.Column="1" Content="로그아웃" Width="90" Height="32" Margin="0,0,24,0"
                    Background="#1F2937" Foreground="#9CA3AF" BorderThickness="0"
                    Cursor="Hand" Click="btnLogout_Click"/>
        </Grid>

        <!-- 본문: 스크롤 가능 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="bodyGrid" Margin="20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="560"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="560"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══ 웨이퍼 생산 성공 배너 (스택, 전체 폭, ZIndex 최상단) ══ -->
            <Border x:Name="waferBanner" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Grid.RowSpan="3"
                    Panel.ZIndex="50" Visibility="Collapsed"
                    VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                    Background="#EE002818" BorderBrush="#22C55E"
                    BorderThickness="0,2,0,0" CornerRadius="0,0,10,10">
                <StackPanel x:Name="waferBannerList"/>
            </Border>

            <!-- ══ 클린룸 1 패널 ══ -->
            <Border x:Name="panelCR1" Grid.Row="0" Grid.Column="0" Visibility="Collapsed" Background="#0D1526" CornerRadius="10"
                    BorderBrush="#1E3A5F" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="20,16,20,8">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="#22D3EE" VerticalAlignment="Center"/>
                                <TextBlock Text="CLEAN ROOM  01" FontSize="15" FontWeight="Bold"
                                           Foreground="#22D3EE" Margin="8,0,0,0"/>
                            </StackPanel>
                            <Border x:Name="iso5Badge1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="#CC061412" BorderBrush="#22C55E" BorderThickness="1"
                                    CornerRadius="6" Padding="8,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="●" Foreground="#22C55E" FontSize="9"
                                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="ISO 5 등급 유지 중" Foreground="#4ADE80"
                                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Rectangle Height="1" Fill="#1E3A5F" Margin="0,10,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="10">
                        <helix:HelixViewport3D x:Name="viewport1"
                                               ShowCoordinateSystem="False"
                                               ShowViewCube="False"
                                               Background="Transparent"
                                               ZoomAroundMouseDownPoint="True"/>
                        <Canvas x:Name="nameCanvas1" Panel.ZIndex="30" IsHitTestVisible="False"/>
                        <!-- 레이어 토글 오버레이 -->
                        <Border VerticalAlignment="Top" HorizontalAlignment="Left"
                                Margin="4,4,0,0" Background="#AA050D15"
                                CornerRadius="6" Padding="5,4" Panel.ZIndex="10">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="tgl1Equip" Style="{StaticResource LayerBtn1}"
                                              Content="장비"   IsChecked="True" Click="Tgl1Equip_Click"/>
                                <ToggleButton x:Name="tgl1Vib"   Style="{StaticResource LayerBtn1}"
                                              Content="진동"   IsChecked="True" Click="Tgl1Vib_Click"/>
                                <ToggleButton x:Name="tgl1TH"    Style="{StaticResource LayerBtn1}"
                                              Content="온습도" IsChecked="True" Click="Tgl1TH_Click"/>
                                <ToggleButton x:Name="tgl1FFU"   Style="{StaticResource LayerBtn1}"
                                              Content="설비"   IsChecked="True" Click="Tgl1FFU_Click"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="infoPanel1" VerticalAlignment="Bottom"
                                Background="#CC0A1020" Padding="12,8"
                                Visibility="Collapsed" CornerRadius="0,0,6,6">
                            <StackPanel>
                                <TextBlock x:Name="infoText1" Foreground="#22D3EE"
                                           FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock x:Name="infoProcess1" Foreground="#7FD3EE"
                                           FontSize="10" Margin="0,3,0,0"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <!-- 에어샤워 작동 배너 -->
                        <Border x:Name="airBanner1" Panel.ZIndex="20" Visibility="Collapsed"
                                VerticalAlignment="Top" HorizontalAlignment="Stretch"
                                Background="#CC1A0000" BorderBrush="#EF4444"
                                BorderThickness="0,0,0,2" Padding="0,9">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🌬" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="에어샤워 가동중" Foreground="#FCA5A5"
                                           FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 출입 요청 알림 배너 -->
                        <Border x:Name="authRequest1" Panel.ZIndex="25" Visibility="Collapsed"
                                VerticalAlignment="Top" HorizontalAlignment="Stretch"
                                Background="#CC0A1A0A" BorderBrush="#22C55E"
                                BorderThickness="0,0,0,2" Padding="10,8">
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="authRequestIcon1" Text="🔔" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="authRequestText1" Text="작업자가 출입을 요청합니다" Foreground="#86EFAC"
                                               FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button x:Name="btnAllow1" Content="허용" HorizontalAlignment="Right"
                                        VerticalAlignment="Center" Padding="14,4"
                                        Background="#16A34A" Foreground="White" FontWeight="Bold"
                                        BorderThickness="0" Cursor="Hand"
                                        Click="BtnAllow1_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- 비밀번호 인증 팝업 -->
                        <Border x:Name="authPopup1" Panel.ZIndex="30" Visibility="Collapsed"
                                Background="#DD030B14" HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="#0F1E30" BorderBrush="#22C55E"
                                    BorderThickness="1" CornerRadius="8" Padding="28,22" MinWidth="280">
                                <StackPanel>
                                    <TextBlock Text="🔐  직원 인증" Foreground="#86EFAC"
                                               FontSize="15" FontWeight="Bold"
                                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="클린룸 출입 비밀번호를 입력하세요"
                                               Foreground="#64748B" FontSize="11"
                                               HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                    <Border Background="#0A1628" BorderBrush="#1E3A5F"
                                            BorderThickness="1" CornerRadius="4" Padding="10,6">
                                        <TextBox x:Name="authInput1" Background="Transparent"
                                                 Foreground="#E2E8F0" FontSize="13"
                                                 BorderThickness="0" CaretBrush="#22C55E"
                                                 KeyDown="AuthInput1_KeyDown"/>
                                    </Border>
                                    <TextBlock x:Name="authError1" Text="❌ 인증 실패 — 다시 입력하세요"
                                               Foreground="#EF4444" FontSize="11"
                                               HorizontalAlignment="Center"
                                               Margin="0,8,0,0" Visibility="Collapsed"/>
                                    <Button x:Name="btnAuthConfirm1" Content="인증" Margin="0,14,0,0"
                                            Background="#16A34A" Foreground="White"
                                            FontWeight="Bold" FontSize="13"
                                            BorderThickness="0" Padding="0,8" Cursor="Hand"
                                            Click="BtnAuthConfirm1_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Border>
                    </Grid>

                    <!-- 시점 아이콘 버튼 (클린룸 1) -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,6,0,8">

                        <!-- 등각 -->
                        <Button Style="{StaticResource IconBtn1}" ToolTip="등각 시점"
                                Click="btnView1_Iso_Click">
                            <StackPanel>
                                <Viewbox Width="22" Height="22">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="#22D3EE" StrokeThickness="1.4" Fill="Transparent"
                                              Data="M 12,3 L 21,7.5 L 12,12 L 3,7.5 Z"/>
                                        <Path Stroke="#22D3EE" StrokeThickness="1.4" Fill="Transparent"
                                              Data="M 3,7.5 L 3,16.5 L 12,21 L 12,12"/>
                                        <Path Stroke="#22D3EE" StrokeThickness="1.4" Fill="Transparent"
                                              Data="M 21,7.5 L 21,16.5 L 12,21"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="등각" Foreground="#22D3EE" FontSize="10"
                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- 정면 -->
                        <Button Style="{StaticResource IconBtn1}" ToolTip="정면 시점"
                                Click="btnView1_Front_Click">
                            <StackPanel>
                                <Viewbox Width="22" Height="22">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="#22D3EE" StrokeThickness="1.4" Fill="Transparent"
                                              Data="M 4,4 L 20,4 L 20,20 L 4,20 Z"/>
                                        <Path Stroke="#22D3EE" StrokeThickness="0.8"
                                              StrokeDashArray="2,2" Fill="Transparent"
                                              Data="M 4,4 L 8,1 L 22,1 L 22,17 L 20,20
                                                    M 8,1 L 8,17 L 20,20
                                                    M 8,1 L 22,1"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="정면" Foreground="#22D3EE" FontSize="10"
                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- 측면 -->
                        <Button Style="{StaticResource IconBtn1}" ToolTip="측면 시점"
                                Click="btnView1_Side_Click">
                            <StackPanel>
                                <Viewbox Width="22" Height="22">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="#22D3EE" StrokeThickness="1.4" Fill="Transparent"
                                              Data="M 8,4 L 20,4 L 20,20 L 8,20 Z"/>
                                        <Path Stroke="#22D3EE" StrokeThickness="1.4" Fill="Transparent"
                                              Data="M 4,7 L 8,4 L 8,20 L 4,17 Z"/>
                                        <Path Stroke="#22D3EE" StrokeThickness="0.8"
                                              StrokeDashArray="2,2" Fill="Transparent"
                                              Data="M 4,7 L 20,4 M 4,17 L 20,20"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="측면" Foreground="#22D3EE" FontSize="10"
                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- 상단 -->
                        <Button Style="{StaticResource IconBtn1}" ToolTip="상단 시점"
                                Click="btnView1_Top_Click">
                            <StackPanel>
                                <Viewbox Width="22" Height="22">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="#22D3EE" StrokeThickness="1.4" Fill="Transparent"
                                              Data="M 12,4 L 21,9 L 12,14 L 3,9 Z"/>
                                        <Path Stroke="#22D3EE" StrokeThickness="0.8"
                                              StrokeDashArray="2,2" Fill="Transparent"
                                              Data="M 3,9 L 3,16 L 12,21 L 21,16 L 21,9
                                                    M 12,14 L 12,21"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="상단" Foreground="#22D3EE" FontSize="10"
                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- 자동회전 -->
                        <ToggleButton x:Name="btnAutoRotate1" Width="52" Height="58"
                                      Focusable="False"
                                      ToolTip="자동 회전" Click="btnAutoRotate1_Click">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bg" Background="#0D2035" BorderBrush="#1E3A5F"
                                            BorderThickness="1" CornerRadius="6">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Viewbox Width="22" Height="22">
                                                <Canvas Width="24" Height="24">
                                                    <Path x:Name="arc" Stroke="#22D3EE" StrokeThickness="1.5"
                                                          Fill="Transparent"
