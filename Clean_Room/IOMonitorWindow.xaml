<Window x:Class="Clean_Room.IOMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CleanRoom I/O Monitor"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        Background="#111827"
        ResizeMode="NoResize">

    <Grid Width="380" Margin="24">
        <StackPanel VerticalAlignment="Center">

            <!-- ── 관리자 인증 모드 패널 (auth mode에서만 표시) ── -->
            <StackPanel x:Name="authPanel" Visibility="Collapsed" Margin="0,0,0,20">
                <TextBlock Text="🔐 관리자 인증"
                           FontSize="18" FontWeight="Bold"
                           Foreground="#22D3EE" HorizontalAlignment="Center"
                           Margin="0,0,0,6"/>
                <TextBlock Text="장비 버튼을 입력하세요"
                           FontSize="12" Foreground="#9CA3AF"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>

                <!-- 시퀀스 표시 (○○○ | ○) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <Ellipse x:Name="seqDot1" Width="22" Height="22" Fill="#374151" Margin="4,0"/>
                    <Ellipse x:Name="seqDot2" Width="22" Height="22" Fill="#374151" Margin="4,0"/>
                    <Ellipse x:Name="seqDot3" Width="22" Height="22" Fill="#374151" Margin="4,0"/>
                    <Rectangle Width="1" Fill="#4B5563" Margin="10,0"/>
                    <Ellipse x:Name="seqDot4" Width="22" Height="22" Fill="#374151" Margin="4,0"/>
                </StackPanel>

                <TextBlock x:Name="txtAuthStatus" Text="장비 연결 중..."
                           FontSize="12" Foreground="#9CA3AF"
                           HorizontalAlignment="Center"/>

                <!-- 타임아웃 바 -->
                <ProgressBar x:Name="timeoutBar" Height="3" Margin="0,10,0,0"
                             Background="#1F2937" Foreground="#22D3EE"
                             Maximum="100" Value="100" BorderThickness="0"/>
            </StackPanel>

            <!-- ── 기존 I/O 모니터 UI ── -->
            <TextBlock x:Name="txtStatus" Text="연결 안됨"
                       FontSize="14" FontWeight="Bold" Margin="0,0,0,16" Foreground="#EF4444"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Input  1 (Button1) : " FontSize="15" Width="180" Foreground="#9CA3AF"/>
                <Ellipse x:Name="ellInput" Width="22" Height="22" Fill="#4B5563"/>
                <TextBlock x:Name="txtInput" Text="OFF" FontSize="13" Foreground="White"
                           Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <TextBlock Text="Output 1 (Lamp1)   : " FontSize="15" Width="180" Foreground="#9CA3AF"/>
                <Ellipse x:Name="ellOutput" Width="22" Height="22" Fill="#4B5563"/>
                <TextBlock x:Name="txtOutput" Text="OFF" FontSize="13" Foreground="White"
                           Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel x:Name="btnPanel" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="연결" Width="90" Height="32" Margin="0,0,12,0"
                        Background="#22D3EE" Foreground="#111827" FontWeight="Bold"
                        BorderThickness="0" Click="BtnConnect_Click" Cursor="Hand"/>
                <Button Content="해제" Width="90" Height="32"
                        Background="#374151" Foreground="White" FontWeight="Bold"
                        BorderThickness="0" Click="BtnDisconnect_Click" Cursor="Hand"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
