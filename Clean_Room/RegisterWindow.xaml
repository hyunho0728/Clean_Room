<Window x:Class="Clean_Room.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="클린룸 모니터링 시스템 - 회원가입"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        Background="#111827"
        ResizeMode="NoResize">
    <Grid Width="400" Margin="30"> 
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="CREATE ACCOUNT" FontSize="24" FontWeight="Bold"
                       Foreground="#818CF8" HorizontalAlignment="Center" Margin="0,0,0,25"/>

            <!-- 아이디 -->
            <TextBlock Text="ID" Foreground="#9CA3AF" Margin="0,5,0,2"/>
            <TextBox x:Name="txtRegUserID" Height="35" VerticalContentAlignment="Center"
                     Background="#1F2937" Foreground="White" BorderBrush="#374151" Padding="5,0"/>

            <!-- 이름 -->
            <TextBlock Text="이름" Foreground="#9CA3AF" Margin="0,10,0,2"/>
            <TextBox x:Name="txtRegFullName" Height="35" VerticalContentAlignment="Center"
                     Background="#1F2937" Foreground="White" BorderBrush="#374151" Padding="5,0"/>

            <!-- 비밀번호 -->
            <TextBlock Text="비밀번호" Foreground="#9CA3AF" Margin="0,10,0,2"/>
            <PasswordBox x:Name="txtRegPassword" Height="35" VerticalContentAlignment="Center"
                         Background="#1F2937" Foreground="White" BorderBrush="#374151" Padding="5,0"/>

            <!-- 비밀번호 확인 -->
            <TextBlock Text="비밀번호 확인" Foreground="#9CA3AF" Margin="0,10,0,2"/>
            <PasswordBox x:Name="txtRegPasswordConfirm" Height="35" VerticalContentAlignment="Center"
                         Background="#1F2937" Foreground="White" BorderBrush="#374151" Padding="5,0"/>

            <!-- 전화번호 -->
            <TextBlock Text="전화번호" Foreground="#9CA3AF" Margin="0,10,0,2"/>
            <TextBox x:Name="txtRegPhone" Height="35" VerticalContentAlignment="Center"
                     Background="#1F2937" Foreground="White" BorderBrush="#374151" Padding="5,0"/>

            <!-- 직무 -->
            <TextBlock Text="직무" Foreground="#9CA3AF" Margin="0,10,0,2"/>
            <StackPanel x:Name="pnlRegRole" Margin="5,4,0,0">
                <RadioButton Content="관리자"       Foreground="White" Margin="0,3" GroupName="Role"/> <!-- 주로 모니터링 하는 대상 -->
                <RadioButton Content="작업자"       Foreground="White" Margin="0,3" GroupName="Role"/> 
                <RadioButton Content="장비 엔지니어" Foreground="White" Margin="0,3" GroupName="Role"/> <!-- 진동 이상 감지 시 클린룸 내 공정 장비 수리 -->
                
            </StackPanel>

            <!-- 성별 -->
            <TextBlock Text="성별" Foreground="#9CA3AF" Margin="0,10,0,2"/>
            <StackPanel x:Name="pnlRegGender" Margin="5,4,0,0">
                <RadioButton Content="남성" Foreground="White" Margin="0,3" GroupName="Gender"/>
                <RadioButton Content="여성" Foreground="White" Margin="0,3" GroupName="Gender"/>
            </StackPanel>

            <!-- 이메일 -->
            <TextBlock Text="이메일" Foreground="#9CA3AF" Margin="0,10,0,2"/>
            <TextBox x:Name="txtRegEmail" Height="35" VerticalContentAlignment="Center"
                     Background="#1F2937" Foreground="White" BorderBrush="#374151" Padding="5,0"/>

            <Button x:Name="btnRegister" Content="가입 완료" Height="40" Margin="0,25,0,5"
                    Background="#818CF8" Foreground="White" FontWeight="Bold"
                    BorderThickness="0" Click="btnRegister_Click" Cursor="Hand"/>

            <Button x:Name="btnBack" Content="로그인 화면으로 돌아가기" Background="Transparent"
                    Foreground="#9CA3AF" BorderThickness="0" Cursor="Hand" Click="btnBack_Click"/>
        </StackPanel>
    </Grid>
</Window>
