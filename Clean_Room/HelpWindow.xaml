<Window x:Class="Clean_Room.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="센서 위험값 안내"
        Background="#0A0F1E"
        Width="400" Height="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="❓" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="센서 위험값 안내" Foreground="#E2E8F0"
                           FontSize="15" FontWeight="Bold"/>
                <TextBlock Text="아래 값을 초과하면 알람이 발생합니다"
                           Foreground="#4B5563" FontSize="10" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- 구분선 -->
        <Border Grid.Row="1" Height="1" Background="#1E3A5F" VerticalAlignment="Center"/>

        <!-- 센서 목록 -->
        <StackPanel Grid.Row="2" VerticalAlignment="Top">

            <!-- 온도 -->
            <Border Background="#0D1B2A" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🌡" FontSize="18" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="온도" Foreground="#E2E8F0" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Temperature" Foreground="#4B5563" FontSize="10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="30 °C 초과" Foreground="#F87171"
                                   FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                        <TextBlock Text="경고 28 °C" Foreground="#FBBF24"
                                   FontSize="10" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 습도 -->
            <Border Background="#0D1B2A" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="💧" FontSize="18" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="습도" Foreground="#E2E8F0" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Humidity" Foreground="#4B5563" FontSize="10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="80 %RH 초과" Foreground="#F87171"
                                   FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                        <TextBlock Text="경고 70 %RH" Foreground="#FBBF24"
                                   FontSize="10" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 압력 -->
            <Border Background="#0D1B2A" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="⟳" FontSize="18" Foreground="#A78BFA" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="압력" Foreground="#E2E8F0" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Pressure  ※ 초과 시 에어샤워 동작" Foreground="#4B5563" FontSize="10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="0.1 MPa 초과" Foreground="#F87171"
                                   FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                        <TextBlock Text="경고 0.08 MPa" Foreground="#FBBF24"
                                   FontSize="10" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 진동 -->
            <Border Background="#0D1B2A" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="📳" FontSize="18" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="진동" Foreground="#E2E8F0" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Vibration" Foreground="#4B5563" FontSize="10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="1.5 m/s² 초과" Foreground="#F87171"
                                   FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                        <TextBlock Text="경고 1.0 m/s²" Foreground="#FBBF24"
                                   FontSize="10" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 거리 -->
            <Border Background="#0D1B2A" CornerRadius="8" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="📏" FontSize="18" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="거리" Foreground="#E2E8F0" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Distance" Foreground="#4B5563" FontSize="10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="4.8 m 초과" Foreground="#F87171"
                                   FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                        <TextBlock Text="경고 4.5 m" Foreground="#FBBF24"
                                   FontSize="10" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>

        <!-- 닫기 버튼 -->
        <Button Grid.Row="4" Content="확인" Click="BtnOk_Click"
                Background="#1E3A5F" BorderBrush="#22D3EE"
                Foreground="#22D3EE" FontSize="12" FontWeight="SemiBold"
                Padding="0,8" HorizontalAlignment="Stretch"
                Cursor="Hand"/>
    </Grid>
</Window>
