<Window x:Class="Clean_Room.WorkerAuthDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="직원 출입 인증"
        Width="360" Height="360"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0F1E30"
        BorderBrush="#22C55E"
        BorderThickness="1">
    <Grid Margin="28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 타이틀 -->
        <TextBlock x:Name="txtTitle" Grid.Row="0"
                   Foreground="#86EFAC" FontSize="15" FontWeight="Bold"
                   HorizontalAlignment="Center"/>

        <!-- 단계 표시 -->
        <TextBlock x:Name="txtStep" Grid.Row="1"
                   Foreground="#64748B" FontSize="11"
                   HorizontalAlignment="Center" Margin="0,4,0,0"/>

        <!-- 1단계 패널 -->
        <StackPanel x:Name="step1Panel" Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="아이디" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,4"/>
            <Border Background="#0A1628" BorderBrush="#1E3A5F"
                    BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,10">
                <TextBox x:Name="txtId" Background="Transparent"
                         Foreground="#E2E8F0" FontSize="13"
                         BorderThickness="0" CaretBrush="#22C55E"
                         KeyDown="TxtId_KeyDown"/>
            </Border>

            <TextBlock Text="비밀번호" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,4"/>
            <Border Background="#0A1628" BorderBrush="#1E3A5F"
                    BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,10">
                <PasswordBox x:Name="txtPw" Background="Transparent"
                             Foreground="#E2E8F0" FontSize="13"
                             BorderThickness="0" CaretBrush="#22C55E"
                             KeyDown="TxtPw_KeyDown"/>
            </Border>

            <TextBlock x:Name="step1Error"
                       Text="❌ 아이디/비밀번호 또는 직무가 일치하지 않습니다"
                       Foreground="#EF4444" FontSize="10"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8" Visibility="Collapsed" TextWrapping="Wrap"/>

            <Button Content="다음 →" Margin="0,4,0,0"
                    FontWeight="Bold" FontSize="13"
                    Padding="0,8" Cursor="Hand"
                    Click="BtnNext_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="#16A34A"
                                BorderThickness="0" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="White"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#15803D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <!-- 2단계 패널 -->
        <StackPanel x:Name="step2Panel" Grid.Row="2" Margin="0,16,0,0" Visibility="Collapsed">
            <TextBlock x:Name="txt2ndLabel"
                       Foreground="#64748B" FontSize="11"
                       HorizontalAlignment="Center" Margin="0,0,0,16"
                       TextWrapping="Wrap"/>
            <Border Background="#0A1628" BorderBrush="#1E3A5F"
                    BorderThickness="1" CornerRadius="4" Padding="10,6">
                <TextBox x:Name="txt2nd" Background="Transparent"
                         Foreground="#E2E8F0" FontSize="13"
                         BorderThickness="0" CaretBrush="#22C55E"
                         KeyDown="Txt2nd_KeyDown"/>
            </Border>

            <TextBlock x:Name="step2Error"
                       Text="❌ 2차 인증 실패 — 다시 입력하세요"
                       Foreground="#EF4444" FontSize="11"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0" Visibility="Collapsed"/>

            <Button Content="인증" Margin="0,14,0,0"
                    FontWeight="Bold" FontSize="13"
                    Padding="0,8" Cursor="Hand"
                    Click="BtnConfirm_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="#16A34A"
                                BorderThickness="0" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="White"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#15803D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <!-- 취소 -->
        <Button Grid.Row="3" Content="취소" Margin="0,10,0,0"
                Background="Transparent" Foreground="#475569"
                BorderThickness="0" FontSize="11" Cursor="Hand"
                Click="BtnCancel_Click"/>
    </Grid>
</Window>
