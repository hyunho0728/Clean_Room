<Window x:Class="Clean_Room.FloatingCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="190" Height="215"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Border Background="#0D1B2A" CornerRadius="10"
            BorderBrush="#1E3A5F" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 드래그 핸들 (타이틀 바) -->
            <Border Grid.Row="0" Background="#060B14"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="DragBar_MouseDown"
                    Cursor="SizeAll">
                <Grid Margin="10,0,6,0">
                    <TextBlock x:Name="txtTitle" Foreground="#9CA3AF"
                               FontSize="10" VerticalAlignment="Center"/>
                    <Button Content="✕" HorizontalAlignment="Right"
                            Click="BtnClose_Click"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#6B7280" FontSize="11"
                            Cursor="Hand" Padding="4,0"/>
                </Grid>
            </Border>

            <!-- 게이지 + 상태 -->
            <StackPanel Grid.Row="1" Margin="8,4,8,8">
                <Canvas x:Name="arcCanvas" Height="140" ClipToBounds="True"/>
                <TextBlock x:Name="statusDot" Text="● 대기"
                           HorizontalAlignment="Center"
                           FontSize="10" Foreground="#6B7280"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
