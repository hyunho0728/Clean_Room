<Window x:Class="Clean_Room.AuthDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="직원 인증"
        Width="340" Height="230"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0F1E30"
        BorderBrush="#22C55E"
        BorderThickness="1">
    <Grid Margin="28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🔐  직원 인증" Foreground="#86EFAC"
                   FontSize="15" FontWeight="Bold"
                   HorizontalAlignment="Center"/>

        <TextBlock Grid.Row="1" Text="클린룸 출입 비밀번호를 입력하세요"
                   Foreground="#64748B" FontSize="11"
                   HorizontalAlignment="Center" Margin="0,6,0,0"/>

        <Border Grid.Row="3" Background="#0A1628" BorderBrush="#1E3A5F"
                BorderThickness="1" CornerRadius="4" Padding="10,6">
            <TextBox x:Name="authInput" Background="Transparent"
                     Foreground="#E2E8F0" FontSize="13"
                     BorderThickness="0" CaretBrush="#22C55E"
                     KeyDown="AuthInput_KeyDown"/>
        </Border>

        <TextBlock x:Name="authError" Grid.Row="4"
                   Text="❌ 인증 실패 — 다시 입력하세요"
                   Foreground="#EF4444" FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,8,0,0" Visibility="Collapsed"/>

        <Button Grid.Row="5" Content="인증" Margin="0,14,0,0"
                FontWeight="Bold" FontSize="13"
                Padding="0,8" Cursor="Hand"
                Click="BtnConfirm_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="#16A34A"
                            BorderThickness="0" CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="White"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#15803D"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#166534"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
