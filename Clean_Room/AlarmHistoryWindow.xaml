<Window x:Class="Clean_Room.AlarmHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="알람 이력 조회"
        Background="#0A0F1E"
        Width="680" Height="520"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 헤더 (SensorDashboard 알람 로그 헤더와 동일 스타일) -->
        <Border Grid.Row="0" Background="#0D1B2A"
                BorderBrush="#1E3A5F" BorderThickness="1" CornerRadius="6" Padding="16,7">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Fill="#F87171" VerticalAlignment="Center"/>
                <TextBlock Text="알람 로그" Foreground="#F87171"
                           FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtResultCount" Foreground="#4B5563"
                           FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- DB 기간 조회 -->
        <Border Grid.Row="2" Background="#0D1B2A" CornerRadius="6"
                BorderBrush="#1E3A5F" BorderThickness="1" Padding="14,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="DB 조회" Foreground="#6B7280" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <DatePicker x:Name="dpFrom" Width="118"
                            Background="#0A0F1E" Foreground="White" BorderBrush="#374151"/>
                <TextBlock Text=" ~ " Foreground="#6B7280"
                           VerticalAlignment="Center" Margin="4,0"/>
                <DatePicker x:Name="dpTo" Width="118"
                            Background="#0A0F1E" Foreground="White" BorderBrush="#374151"/>
                <Button Content="조회" Click="BtnSearch_Click"
                        Background="#1E3A5F" BorderBrush="#22D3EE"
                        Foreground="#22D3EE" FontSize="11"
                        Padding="12,3" Margin="10,0,0,0" Cursor="Hand"/>
                <Button Content="라이브" Click="BtnLive_Click"
                        Background="Transparent" BorderBrush="#F87171"
                        Foreground="#F87171" FontSize="11"
                        Padding="10,3" Margin="6,0,0,0" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- 알람 로그 (SensorDashboard 알람 로그와 동일 스타일) -->
        <Border Grid.Row="4" Background="#060B14" CornerRadius="6"
                BorderBrush="#1E3A5F" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="alarmList" Margin="12,6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Margin="0,2" Padding="12,6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#0D1B2A"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEquipmentFault}" Value="True">
                                                <Setter Property="Background"      Value="#1A0D1B"/>
                                                <Setter Property="BorderBrush"     Value="#7C3AED"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>   <!-- 구역 -->
                                        <ColumnDefinition Width="148"/>  <!-- 시간 -->
                                        <ColumnDefinition Width="58"/>   <!-- 센서 -->
                                        <ColumnDefinition Width="90"/>   <!-- 측정값 -->
                                        <ColumnDefinition Width="64"/>   <!-- 상태 -->
                                        <ColumnDefinition Width="88"/>   <!-- 고장 장비 -->
                                        <ColumnDefinition Width="*"/>    <!-- 정비 상태 -->
                                    </Grid.ColumnDefinitions>

                                    <!-- 구역 -->
                                    <TextBlock Grid.Column="0" Text="{Binding Room}"
                                               Foreground="#818CF8" FontSize="11" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <!-- 시간 -->
                                    <TextBlock Grid.Column="1" Text="{Binding Timestamp}"
                                               Foreground="#6B7280" FontSize="10" FontFamily="Consolas"
                                               VerticalAlignment="Center"/>
                                    <!-- 센서 -->
                                    <TextBlock Grid.Column="2" Text="{Binding Sensor}"
                                               Foreground="#FCD34D" FontSize="11" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <!-- 측정값 + 단위 -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Value, StringFormat=F2}"
                                                   Foreground="#F87171" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Unit}"
                                                   Foreground="#9CA3AF" FontSize="10"
                                                   Margin="3,0,0,0" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                    <!-- 상태 -->
                                    <TextBlock Grid.Column="4" FontSize="10" FontWeight="SemiBold"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text"       Value="✅ 정상"/>
                                                <Setter Property="Foreground" Value="#22C55E"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="위험">
                                                        <Setter Property="Text"       Value="🔴 위험"/>
                                                        <Setter Property="Foreground" Value="#F87171"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- 고장 장비 -->
                                    <TextBlock Grid.Column="5" Text="{Binding EquipmentName}"
                                               Foreground="#C084FC" FontSize="10" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <!-- 정비 상태 -->
                                    <TextBlock Grid.Column="6" FontSize="10" FontWeight="SemiBold"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text"       Value=""/>
                                                <Setter Property="Foreground" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MaintenanceStatus}" Value="정비 필요">
                                                        <Setter Property="Text"       Value="🔧 정비 필요"/>
                                                        <Setter Property="Foreground" Value="#FBBF24"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding MaintenanceStatus}" Value="정상">
                                                        <Setter Property="Text"       Value="✅ 정상"/>
                                                        <Setter Property="Foreground" Value="#22C55E"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 하단 버튼 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="📥 CSV 내보내기" Click="BtnExport_Click"
                    Background="Transparent" BorderBrush="#34D399"
                    Foreground="#34D399" FontSize="11"
                    Padding="14,5" Margin="0,0,8,0" Cursor="Hand"/>
            <Button Content="닫기" Click="BtnClose_Click"
                    Background="Transparent" BorderBrush="#374151"
                    Foreground="#9CA3AF" FontSize="11"
                    Padding="14,5" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
