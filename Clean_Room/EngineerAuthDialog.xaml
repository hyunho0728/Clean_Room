<Window x:Class="Clean_Room.EngineerAuthDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="장비 엔지니어 출입 인증"
        Width="380" Height="380"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#080F1C"
        BorderBrush="#3B82F6"
        BorderThickness="1">
    <Grid>
        <!-- 상단 파란 강조 바 -->
        <Rectangle Height="4" VerticalAlignment="Top" Fill="#3B82F6"/>

        <Grid Margin="28,26,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 아이콘 + 타이틀 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                <Border Background="#0F2044" BorderBrush="#3B82F6" BorderThickness="1"
                        CornerRadius="6" Padding="8,5" Margin="0,0,10,0">
                    <TextBlock Text="🔧" FontSize="16" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="txtTitle"
                           Foreground="#60A5FA" FontSize="15" FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 구분선 -->
            <Rectangle Grid.Row="1" Height="1" Fill="#1E3A6E" Margin="0,10,0,0"/>

            <!-- 단계 표시 -->
            <TextBlock x:Name="txtStep" Grid.Row="2"
                       Foreground="#64748B" FontSize="11"
                       HorizontalAlignment="Center" Margin="0,8,0,0"/>

            <!-- 1단계 패널 -->
            <StackPanel x:Name="step1Panel" Grid.Row="3" Margin="0,12,0,0">
                <TextBlock Text="아이디" Foreground="#93C5FD" FontSize="11" Margin="0,0,0,4"/>
                <Border Background="#060D1A" BorderBrush="#1E3A6E"
                        BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,10">
                    <TextBox x:Name="txtId" Background="Transparent"
                             Foreground="#E2E8F0" FontSize="13"
                             BorderThickness="0" CaretBrush="#60A5FA"
                             KeyDown="TxtId_KeyDown"/>
                </Border>

                <TextBlock Text="비밀번호" Foreground="#93C5FD" FontSize="11" Margin="0,0,0,4"/>
                <Border Background="#060D1A" BorderBrush="#1E3A6E"
                        BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,10">
                    <PasswordBox x:Name="txtPw" Background="Transparent"
                                 Foreground="#E2E8F0" FontSize="13"
                                 BorderThickness="0" CaretBrush="#60A5FA"
                                 KeyDown="TxtPw_KeyDown"/>
                </Border>

                <TextBlock x:Name="step1Error"
                           Text="❌ 아이디/비밀번호 또는 직무가 일치하지 않습니다"
                           Foreground="#F87171" FontSize="10"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8" Visibility="Collapsed" TextWrapping="Wrap"/>

                <Button Content="다음 →" Margin="0,4,0,0"
                        FontWeight="Bold" FontSize="13"
                        Padding="0,9" Cursor="Hand"
                        Click="BtnNext_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="#D97706"
                                    BorderThickness="0" CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="White"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#B45309"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- 2단계 패널 -->
            <StackPanel x:Name="step2Panel" Grid.Row="3" Margin="0,12,0,0" Visibility="Collapsed">
                <TextBlock x:Name="txt2ndLabel"
                           Foreground="#94A3B8" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,0,0,16"
                           TextWrapping="Wrap"/>
                <Border Background="#060D1A" BorderBrush="#1E3A6E"
                        BorderThickness="1" CornerRadius="4" Padding="10,6">
                    <TextBox x:Name="txt2nd" Background="Transparent"
                             Foreground="#E2E8F0" FontSize="13"
                             BorderThickness="0" CaretBrush="#60A5FA"
                             KeyDown="Txt2nd_KeyDown"/>
                </Border>

                <TextBlock x:Name="step2Error"
                           Text="❌ 2차 인증 실패 — 다시 입력하세요"
                           Foreground="#F87171" FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0" Visibility="Collapsed"/>

                <Button Content="인증 완료" Margin="0,14,0,0"
                        FontWeight="Bold" FontSize="13"
                        Padding="0,9" Cursor="Hand"
                        Click="BtnConfirm_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="#1D4ED8"
                                    BorderThickness="0" CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="White"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#1E40AF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- 취소 -->
            <Button Grid.Row="4" Content="취소" Margin="0,10,0,0"
                    Background="Transparent" Foreground="#475569"
                    BorderThickness="0" FontSize="11" Cursor="Hand"
                    Click="BtnCancel_Click"/>
        </Grid>
    </Grid>
</Window>
