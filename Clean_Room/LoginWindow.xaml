<Window x:Class="Clean_Room.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="클린룸 모니터링 시스템 - 로그인" 
        SizeToContent="WidthAndHeight" 
        WindowStartupLocation="CenterScreen" 
        Background="#111827"
        ResizeMode="NoResize">
    <Grid Width="400" Margin="30">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="CLEANROOM SYSTEM" FontSize="26" FontWeight="Bold" 
                       Foreground="#22D3EE" HorizontalAlignment="Center" Margin="0,0,0,25"/>

            <TextBlock Text="사용자 ID" Foreground="#9CA3AF" Margin="0,5,0,2"/>
            <TextBox x:Name="txtUsername" Height="35" VerticalContentAlignment="Center" 
                     Background="#1F2937" Foreground="White" BorderBrush="#374151" Padding="5,0"/>

            <TextBlock Text="비밀번호" Foreground="#9CA3AF" Margin="0,15,0,2"/>
            <PasswordBox x:Name="txtPassword" Height="35" VerticalContentAlignment="Center" 
                         Background="#1F2937" Foreground="White" BorderBrush="#374151" Padding="5,0"/>

            <Button x:Name="btnLogin" Content="로그인" Height="40" Margin="0,25,0,5" 
                    Background="#22D3EE" Foreground="#111827" FontWeight="Bold" 
                    BorderThickness="0" Click="btnLogin_Click" Cursor="Hand"/>

            <Button x:Name="btnGoToRegister" Content="새 계정 만들기 (회원가입)" Background="Transparent" 
                    Foreground="#9CA3AF" BorderThickness="0" Cursor="Hand" Click="btnGoToRegister_Click"/>
        </StackPanel>
    </Grid>
</Window>