<Window x:Class="Clean_Room.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helix="http://helix-toolkit.org/wpf"
        Title="클린룸 모니터링 시스템 - 관리자"
        WindowStartupLocation="CenterScreen"
        Background="#0A0F1E"
        Width="1200" Height="720"
        MinWidth="900" MinHeight="500">

    <Window.Resources>
        <!-- 클린룸1 아이콘 버튼 스타일 -->
        <Style x:Key="IconBtn1" TargetType="Button">
            <Setter Property="Width"           Value="52"/>
            <Setter Property="Height"          Value="58"/>
            <Setter Property="Margin"          Value="4,0"/>
            <Setter Property="Background"      Value="#0D2035"/>
            <Setter Property="BorderBrush"     Value="#1E3A5F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E3A5F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#22D3EE22"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 클린룸2 아이콘 버튼 스타일 -->
        <Style x:Key="IconBtn2" TargetType="Button">
            <Setter Property="Width"           Value="52"/>
            <Setter Property="Height"          Value="58"/>
            <Setter Property="Margin"          Value="4,0"/>
            <Setter Property="Background"      Value="#120D2A"/>
            <Setter Property="BorderBrush"     Value="#2D1B5E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2D1B5E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#818CF822"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <Grid Grid.Row="0" Background="#0D1526">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0">
                <TextBlock Text="■ CLEANROOM" FontSize="18" FontWeight="Bold"
                           Foreground="#22D3EE" VerticalAlignment="Center"/>
                <TextBlock Text="MONITORING SYSTEM" FontSize="18"
                           Foreground="#FFFFFF" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBlock x:Name="txtAdminName" FontSize="13"
                           Foreground="#6B7280" VerticalAlignment="Center" Margin="24,0,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="로그아웃" Width="90" Height="32" Margin="0,0,24,0"
                    Background="#1F2937" Foreground="#9CA3AF" BorderThickness="0"
                    Cursor="Hand" Click="btnLogout_Click"/>
        </Grid>

        <!-- 본문: 좌우 분할 -->
        <Grid Grid.Row="1" Margin="20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══ 클린룸 1 패널 ══ -->
            <Border Grid.Column="0" Background="#0D1526" CornerRadius="10"
                    BorderBrush="#1E3A5F" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="20,16,20,8">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="#22D3EE" VerticalAlignment="Center"/>
                            <TextBlock Text="CLEAN ROOM  01" FontSize="15" FontWeight="Bold"
                                       Foreground="#22D3EE" Margin="8,0,0,0"/>
                        </StackPanel>
                        <Rectangle Height="1" Fill="#1E3A5F" Margin="0,10,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="10">
                        <helix:HelixViewport3D x:Name="viewport1"
                                               ShowCoordinateSystem="False"
                                               ShowViewCube="False"
                                               Background="Transparent"
                                               ZoomAroundMouseDownPoint="True"/>
                        <Border x:Name="infoPanel1" VerticalAlignment="Bottom"
                                Background="#CC0A1020" Padding="12,8"
                                Visibility="Collapsed" CornerRadius="0,0,6,6">
                            <StackPanel>
                                <TextBlock x:Name="infoText1" Foreground="#22D3EE"
                                           FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock x:Name="infoProcess1" Foreground="#7FD3EE"
                                           FontSize="10" Margin="0,3,0,0"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 시점 아이콘 버튼 (클린룸 1) -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,6,0,8">

                        <!-- 등각 -->
                        <Button Style="{StaticResource IconBtn1}" ToolTip="등각 시점"
                                Click="btnView1_Iso_Click">
                            <StackPanel>
                                <Viewbox Width="22" Height="22">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="#22D3EE" StrokeThickness="1.4" Fill="Transparent"
                                              Data="M 12,3 L 21,7.5 L 12,12 L 3,7.5 Z"/>
                                        <Path Stroke="#22D3EE" StrokeThickness="1.4" Fill="Transparent"
                                              Data="M 3,7.5 L 3,16.5 L 12,21 L 12,12"/>
                                        <Path Stroke="#22D3EE" StrokeThickness="1.4" Fill="Transparent"
                                              Data="M 21,7.5 L 21,16.5 L 12,21"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="등각" Foreground="#22D3EE" FontSize="10"
                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- 정면 -->
                        <Button Style="{StaticResource IconBtn1}" ToolTip="정면 시점"
                                Click="btnView1_Front_Click">
                            <StackPanel>
                                <Viewbox Width="22" Height="22">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="#22D3EE" StrokeThickness="1.4" Fill="Transparent"
                                              Data="M 4,4 L 20,4 L 20,20 L 4,20 Z"/>
                                        <Path Stroke="#22D3EE" StrokeThickness="0.8"
                                              StrokeDashArray="2,2" Fill="Transparent"
                                              Data="M 4,4 L 8,1 L 22,1 L 22,17 L 20,20
                                                    M 8,1 L 8,17 L 20,20
                                                    M 8,1 L 22,1"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="정면" Foreground="#22D3EE" FontSize="10"
                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- 측면 -->
                        <Button Style="{StaticResource IconBtn1}" ToolTip="측면 시점"
                                Click="btnView1_Side_Click">
                            <StackPanel>
                                <Viewbox Width="22" Height="22">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="#22D3EE" StrokeThickness="1.4" Fill="Transparent"
                                              Data="M 8,4 L 20,4 L 20,20 L 8,20 Z"/>
                                        <Path Stroke="#22D3EE" StrokeThickness="1.4" Fill="Transparent"
                                              Data="M 4,7 L 8,4 L 8,20 L 4,17 Z"/>
                                        <Path Stroke="#22D3EE" StrokeThickness="0.8"
                                              StrokeDashArray="2,2" Fill="Transparent"
                                              Data="M 4,7 L 20,4 M 4,17 L 20,20"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="측면" Foreground="#22D3EE" FontSize="10"
                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- 상단 -->
                        <Button Style="{StaticResource IconBtn1}" ToolTip="상단 시점"
                                Click="btnView1_Top_Click">
                            <StackPanel>
                                <Viewbox Width="22" Height="22">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="#22D3EE" StrokeThickness="1.4" Fill="Transparent"
                                              Data="M 12,4 L 21,9 L 12,14 L 3,9 Z"/>
                                        <Path Stroke="#22D3EE" StrokeThickness="0.8"
                                              StrokeDashArray="2,2" Fill="Transparent"
                                              Data="M 3,9 L 3,16 L 12,21 L 21,16 L 21,9
                                                    M 12,14 L 12,21"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="상단" Foreground="#22D3EE" FontSize="10"
                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="20,0,20,14">
                        <Rectangle Height="1" Fill="#1E3A5F" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="#22D3EE" VerticalAlignment="Center"/>
                            <TextBlock Text="정상 가동 중" Foreground="#9CA3AF"
                                       FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ 클린룸 2 패널 ══ -->
            <Border Grid.Column="2" Background="#0D1526" CornerRadius="10"
                    BorderBrush="#2D1B5E" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="20,16,20,8">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="#818CF8" VerticalAlignment="Center"/>
                            <TextBlock Text="CLEAN ROOM  02" FontSize="15" FontWeight="Bold"
                                       Foreground="#818CF8" Margin="8,0,0,0"/>
                        </StackPanel>
                        <Rectangle Height="1" Fill="#2D1B5E" Margin="0,10,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="10">
                        <helix:HelixViewport3D x:Name="viewport2"
                                               ShowCoordinateSystem="False"
                                               ShowViewCube="False"
                                               Background="Transparent"
                                               ZoomAroundMouseDownPoint="True"/>
                        <Border x:Name="infoPanel2" VerticalAlignment="Bottom"
                                Background="#CC0A1020" Padding="12,8"
                                Visibility="Collapsed" CornerRadius="0,0,6,6">
                            <StackPanel>
                                <TextBlock x:Name="infoText2" Foreground="#818CF8"
                                           FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock x:Name="infoProcess2" Foreground="#A89CF8"
                                           FontSize="10" Margin="0,3,0,0"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 시점 아이콘 버튼 (클린룸 2) -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,6,0,8">

                        <!-- 등각 -->
                        <Button Style="{StaticResource IconBtn2}" ToolTip="등각 시점"
                                Click="btnView2_Iso_Click">
                            <StackPanel>
                                <Viewbox Width="22" Height="22">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="#818CF8" StrokeThickness="1.4" Fill="Transparent"
                                              Data="M 12,3 L 21,7.5 L 12,12 L 3,7.5 Z"/>
                                        <Path Stroke="#818CF8" StrokeThickness="1.4" Fill="Transparent"
                                              Data="M 3,7.5 L 3,16.5 L 12,21 L 12,12"/>
                                        <Path Stroke="#818CF8" StrokeThickness="1.4" Fill="Transparent"
                                              Data="M 21,7.5 L 21,16.5 L 12,21"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="등각" Foreground="#818CF8" FontSize="10"
                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- 정면 -->
                        <Button Style="{StaticResource IconBtn2}" ToolTip="정면 시점"
                                Click="btnView2_Front_Click">
                            <StackPanel>
                                <Viewbox Width="22" Height="22">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="#818CF8" StrokeThickness="1.4" Fill="Transparent"
                                              Data="M 4,4 L 20,4 L 20,20 L 4,20 Z"/>
                                        <Path Stroke="#818CF8" StrokeThickness="0.8"
                                              StrokeDashArray="2,2" Fill="Transparent"
                                              Data="M 4,4 L 8,1 L 22,1 L 22,17 L 20,20
                                                    M 8,1 L 8,17 L 20,20
                                                    M 8,1 L 22,1"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="정면" Foreground="#818CF8" FontSize="10"
                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- 측면 -->
                        <Button Style="{StaticResource IconBtn2}" ToolTip="측면 시점"
                                Click="btnView2_Side_Click">
                            <StackPanel>
                                <Viewbox Width="22" Height="22">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="#818CF8" StrokeThickness="1.4" Fill="Transparent"
                                              Data="M 8,4 L 20,4 L 20,20 L 8,20 Z"/>
                                        <Path Stroke="#818CF8" StrokeThickness="1.4" Fill="Transparent"
                                              Data="M 4,7 L 8,4 L 8,20 L 4,17 Z"/>
                                        <Path Stroke="#818CF8" StrokeThickness="0.8"
                                              StrokeDashArray="2,2" Fill="Transparent"
                                              Data="M 4,7 L 20,4 M 4,17 L 20,20"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="측면" Foreground="#818CF8" FontSize="10"
                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- 상단 -->
                        <Button Style="{StaticResource IconBtn2}" ToolTip="상단 시점"
                                Click="btnView2_Top_Click">
                            <StackPanel>
                                <Viewbox Width="22" Height="22">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="#818CF8" StrokeThickness="1.4" Fill="Transparent"
                                              Data="M 12,4 L 21,9 L 12,14 L 3,9 Z"/>
                                        <Path Stroke="#818CF8" StrokeThickness="0.8"
                                              StrokeDashArray="2,2" Fill="Transparent"
                                              Data="M 3,9 L 3,16 L 12,21 L 21,16 L 21,9
                                                    M 12,14 L 12,21"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="상단" Foreground="#818CF8" FontSize="10"
                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="20,0,20,14">
                        <Rectangle Height="1" Fill="#2D1B5E" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="#818CF8" VerticalAlignment="Center"/>
                            <TextBlock Text="정상 가동 중" Foreground="#9CA3AF"
                                       FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 하단 상태바 -->
        <Grid Grid.Row="2" Background="#0D1526">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0">
                <TextBlock Text="● LIVE  " Foreground="#22D3EE" FontSize="11"/>
                <TextBlock x:Name="txtDateTime" Foreground="#4B5563" FontSize="11"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
