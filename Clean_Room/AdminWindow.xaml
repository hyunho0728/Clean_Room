                                                  Content="설비"   IsChecked="True" Click="Tgl2FFU_Click"/>
                                    <Separator Width="8" Background="Transparent"/>
                                    <!-- 거리 센서 추적 토글 (CR1과 동일 스타일) -->
                                    <ToggleButton x:Name="tglDist2" Content="📡거리"
                                                  Click="TglDist2_Click"
                                                  Foreground="#34D399" Background="#2234D399"
                                                  BorderBrush="#34D399" BorderThickness="1"
                                                  FontSize="11" Padding="6,2" Margin="3,0,0,0"
                                                  Cursor="Hand" IsEnabled="False">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="bd"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#4434D399"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="bd" Property="Background" Value="#0A0A0A"/>
                                                        <Setter TargetName="bd" Property="BorderBrush" Value="#1A1A1A"/>
                                                        <Setter Property="Foreground" Value="#222222"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#3334D399"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </StackPanel>
                            </Border>

                            <!-- 입실 / 퇴실 버튼 -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button x:Name="btnCR2Enter" Content="✅  입실"
                                        Click="BtnCR2Enter_Click"
                                        Background="#071A10" BorderBrush="#22C55E" BorderThickness="1"
                                        Foreground="#22C55E" FontSize="11" FontWeight="SemiBold"
                                        Padding="10,5" Margin="0,0,4,0" Cursor="Hand"/>
                                <Button x:Name="btnCR2Exit" Content="🚪  퇴실"
                                        Click="BtnCR2Exit_Click"
                                        Background="#1A0808" BorderBrush="#EF4444" BorderThickness="1"
                                        Foreground="#EF4444" FontSize="11" FontWeight="SemiBold"
                                        Padding="10,5" IsEnabled="False" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="#2E0D0D"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="bg" Property="Background" Value="#0D0505"/>
                                                    <Setter TargetName="bg" Property="BorderBrush" Value="#3A1A1A"/>
                                                    <Setter Property="Foreground" Value="#441A1A"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- 우측: 장비 선택 버튼 세로 배치 (IconBtn2 스타일) -->
                        <ScrollViewer VerticalAlignment="Stretch" HorizontalAlignment="Right"
                                      Margin="0,4,4,4" Panel.ZIndex="10"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Button x:Name="cr2eq1" Style="{StaticResource IconBtn2}" IsEnabled="False"
                                        Width="56" Height="44" Margin="0,2" Click="BtnCR2Eq1_Click">
                                    <StackPanel>
                                        <TextBlock Text="⚗" FontSize="14" HorizontalAlignment="Center"/>
                                        <TextBlock Text="산화로" Foreground="#818CF8" FontSize="9"
                                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="cr2eq2" Style="{StaticResource IconBtn2}" IsEnabled="False"
                                        Width="56" Height="44" Margin="0,2" Click="BtnCR2Eq2_Click">
                                    <StackPanel>
                                        <TextBlock Text="🖼" FontSize="14" HorizontalAlignment="Center"/>
                                        <TextBlock Text="포토리소" Foreground="#818CF8" FontSize="9"
                                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="cr2eq3" Style="{StaticResource IconBtn2}" IsEnabled="False"
                                        Width="56" Height="44" Margin="0,2" Click="BtnCR2Eq3_Click">
                                    <StackPanel>
                                        <TextBlock Text="⚡" FontSize="14" HorizontalAlignment="Center"/>
                                        <TextBlock Text="식각기" Foreground="#818CF8" FontSize="9"
                                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="cr2eq4" Style="{StaticResource IconBtn2}" IsEnabled="False"
                                        Width="56" Height="44" Margin="0,2" Click="BtnCR2Eq4_Click">
                                    <StackPanel>
                                        <TextBlock Text="💨" FontSize="14" HorizontalAlignment="Center"/>
                                        <TextBlock Text="CVD" Foreground="#818CF8" FontSize="9"
                                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="cr2eq5" Style="{StaticResource IconBtn2}" IsEnabled="False"
                                        Width="56" Height="44" Margin="0,2" Click="BtnCR2Eq5_Click">
                                    <StackPanel>
                                        <TextBlock Text="⚛" FontSize="14" HorizontalAlignment="Center"/>
                                        <TextBlock Text="이온주입" Foreground="#818CF8" FontSize="9"
                                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="cr2eq6" Style="{StaticResource IconBtn2}" IsEnabled="False"
                                        Width="56" Height="44" Margin="0,2" Click="BtnCR2Eq6_Click">
                                    <StackPanel>
                                        <TextBlock Text="🔄" FontSize="14" HorizontalAlignment="Center"/>
                                        <TextBlock Text="CMP" Foreground="#818CF8" FontSize="9"
                                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="cr2eq7" Style="{StaticResource IconBtn2}" IsEnabled="False"
                                        Width="56" Height="44" Margin="0,2" Click="BtnCR2Eq7_Click">
                                    <StackPanel>
                                        <TextBlock Text="✨" FontSize="14" HorizontalAlignment="Center"/>
                                        <TextBlock Text="PVD" Foreground="#818CF8" FontSize="9"
                                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="cr2eq8" Style="{StaticResource IconBtn2}" IsEnabled="False"
                                        Width="56" Height="44" Margin="0,2" Click="BtnCR2Eq8_Click">
                                    <StackPanel>
                                        <TextBlock Text="💧" FontSize="14" HorizontalAlignment="Center"/>
                                        <TextBlock Text="세정기" Foreground="#818CF8" FontSize="9"
                                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                        <Border x:Name="infoPanel2" VerticalAlignment="Bottom"
                                Background="#CC0A1020" Padding="12,8"
                                Visibility="Collapsed" CornerRadius="0,0,6,6">
                            <StackPanel>
                                <TextBlock x:Name="infoText2" Foreground="#818CF8"
                                           FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock x:Name="infoProcess2" Foreground="#A89CF8"
                                           FontSize="10" Margin="0,3,0,0"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <!-- 에어샤워 작동 배너 -->
                        <Border x:Name="airBanner2" Panel.ZIndex="20" Visibility="Collapsed"
                                VerticalAlignment="Top" HorizontalAlignment="Stretch"
                                Background="#CC1A0000" BorderBrush="#EF4444"
                                BorderThickness="0,0,0,2" Padding="0,9">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🌬" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="에어샤워 가동중" Foreground="#FCA5A5"
                                           FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 출입 요청 알림 배너 (엔지니어 인증) -->
                        <Border x:Name="authRequest2" Panel.ZIndex="25" Visibility="Collapsed"
                                VerticalAlignment="Top" HorizontalAlignment="Stretch"
                                Background="#CC0A1020" BorderBrush="#818CF8"
                                BorderThickness="0,0,0,2" Padding="10,8">
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="🔔" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="엔지니어가 출입을 요청합니다" Foreground="#A5B4FC"
                                               FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button x:Name="btnAllow2" Content="허용 (인증)" HorizontalAlignment="Right"
                                        VerticalAlignment="Center" Padding="14,4"
                                        Background="#4338CA" Foreground="White" FontWeight="Bold"
                                        BorderThickness="0" Cursor="Hand"
                                        Click="BtnAllow2_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- 비밀번호 인증 팝업 -->
                        <Border x:Name="authPopup2" Panel.ZIndex="30" Visibility="Collapsed"
                                Background="#DD030B14" HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="#0F1E30" BorderBrush="#22C55E"
                                    BorderThickness="1" CornerRadius="8" Padding="28,22" MinWidth="280">
                                <StackPanel>
                                    <TextBlock Text="🔐  직원 인증" Foreground="#86EFAC"
                                               FontSize="15" FontWeight="Bold"
                                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="클린룸 출입 비밀번호를 입력하세요"
                                               Foreground="#64748B" FontSize="11"
                                               HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                    <Border Background="#0A1628" BorderBrush="#1E3A5F"
                                            BorderThickness="1" CornerRadius="4" Padding="10,6">
                                        <TextBox x:Name="authInput2" Background="Transparent"
                                                 Foreground="#E2E8F0" FontSize="13"
                                                 BorderThickness="0" CaretBrush="#22C55E"
                                                 KeyDown="AuthInput2_KeyDown"/>
                                    </Border>
                                    <TextBlock x:Name="authError2" Text="❌ 인증 실패 — 다시 입력하세요"
                                               Foreground="#EF4444" FontSize="11"
                                               HorizontalAlignment="Center"
                                               Margin="0,8,0,0" Visibility="Collapsed"/>
                                    <Button x:Name="btnAuthConfirm2" Content="인증" Margin="0,14,0,0"
                                            Background="#16A34A" Foreground="White"
                                            FontWeight="Bold" FontSize="13"
                                            BorderThickness="0" Padding="0,8" Cursor="Hand"
                                            Click="BtnAuthConfirm2_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Border>
                    </Grid>

                    <!-- 시점 아이콘 버튼 (클린룸 2) -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,6,0,8">

                        <!-- 등각 -->
                        <Button Style="{StaticResource IconBtn2}" ToolTip="등각 시점"
                                Click="btnView2_Iso_Click">
                            <StackPanel>
                                <Viewbox Width="22" Height="22">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="#818CF8" StrokeThickness="1.4" Fill="Transparent"
                                              Data="M 12,3 L 21,7.5 L 12,12 L 3,7.5 Z"/>
                                        <Path Stroke="#818CF8" StrokeThickness="1.4" Fill="Transparent"
                                              Data="M 3,7.5 L 3,16.5 L 12,21 L 12,12"/>
                                        <Path Stroke="#818CF8" StrokeThickness="1.4" Fill="Transparent"
                                              Data="M 21,7.5 L 21,16.5 L 12,21"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="등각" Foreground="#818CF8" FontSize="10"
                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- 정면 -->
                        <Button Style="{StaticResource IconBtn2}" ToolTip="정면 시점"
                                Click="btnView2_Front_Click">
                            <StackPanel>
                                <Viewbox Width="22" Height="22">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="#818CF8" StrokeThickness="1.4" Fill="Transparent"
                                              Data="M 4,4 L 20,4 L 20,20 L 4,20 Z"/>
                                        <Path Stroke="#818CF8" StrokeThickness="0.8"
                                              StrokeDashArray="2,2" Fill="Transparent"
                                              Data="M 4,4 L 8,1 L 22,1 L 22,17 L 20,20
                                                    M 8,1 L 8,17 L 20,20
                                                    M 8,1 L 22,1"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="정면" Foreground="#818CF8" FontSize="10"
                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- 측면 -->
                        <Button Style="{StaticResource IconBtn2}" ToolTip="측면 시점"
                                Click="btnView2_Side_Click">
                            <StackPanel>
                                <Viewbox Width="22" Height="22">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="#818CF8" StrokeThickness="1.4" Fill="Transparent"
                                              Data="M 8,4 L 20,4 L 20,20 L 8,20 Z"/>
                                        <Path Stroke="#818CF8" StrokeThickness="1.4" Fill="Transparent"
                                              Data="M 4,7 L 8,4 L 8,20 L 4,17 Z"/>
                                        <Path Stroke="#818CF8" StrokeThickness="0.8"
                                              StrokeDashArray="2,2" Fill="Transparent"
                                              Data="M 4,7 L 20,4 M 4,17 L 20,20"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="측면" Foreground="#818CF8" FontSize="10"
                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- 상단 -->
                        <Button Style="{StaticResource IconBtn2}" ToolTip="상단 시점"
                                Click="btnView2_Top_Click">
                            <StackPanel>
                                <Viewbox Width="22" Height="22">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="#818CF8" StrokeThickness="1.4" Fill="Transparent"
                                              Data="M 12,4 L 21,9 L 12,14 L 3,9 Z"/>
                                        <Path Stroke="#818CF8" StrokeThickness="0.8"
                                              StrokeDashArray="2,2" Fill="Transparent"
                                              Data="M 3,9 L 3,16 L 12,21 L 21,16 L 21,9
                                                    M 12,14 L 12,21"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="상단" Foreground="#818CF8" FontSize="10"
                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- 자동회전 -->
                        <ToggleButton x:Name="btnAutoRotate2" Width="52" Height="58"
                                      Focusable="False"
                                      ToolTip="자동 회전" Click="btnAutoRotate2_Click">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bg" Background="#0D0D26" BorderBrush="#2D1B5E"
                                            BorderThickness="1" CornerRadius="6">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Viewbox Width="22" Height="22">
                                                <Canvas Width="24" Height="24">
                                                    <Path x:Name="arc" Stroke="#818CF8" StrokeThickness="1.5"
                                                          Fill="Transparent"
                                                          Data="M 20,12 A 8,8 0 1 1 12,4"/>
                                                    <Polygon x:Name="arr" Fill="#818CF8"
                                                             Points="12,1 17,6 7,6"/>
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock x:Name="lbl" Text="회전" Foreground="#818CF8"
                                                       FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="bg"  Property="Background"   Value="#1A0A2A"/>
                                            <Setter TargetName="bg"  Property="BorderBrush"  Value="#A78BFA"/>
                                            <Setter TargetName="arc" Property="Stroke"       Value="#A78BFA"/>
                                            <Setter TargetName="arr" Property="Fill"         Value="#A78BFA"/>
                                            <Setter TargetName="lbl" Property="Foreground"   Value="#A78BFA"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg"  Property="Background"   Value="#2D1B5E"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- 정지/재생 -->
                        <Button x:Name="btnPause2" Content="⏸  정지" Width="52" Height="58" Margin="4,0"
                                Focusable="False" ToolTip="정지 / 재생"
                                Click="BtnPause2_Click"
                                Background="#120D2A" BorderBrush="#2D1B5E" BorderThickness="1"
                                Foreground="#818CF8" FontSize="10" FontWeight="SemiBold" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#2D1B5E"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                    </StackPanel>

                    <!-- ══ 관리자 지시 패널 (클린룸 2 전용) ══ -->
                    <Border Grid.Row="3" Background="#080418" BorderBrush="#2D1B5E"
                            BorderThickness="0,1,0,0" Padding="12,10,12,10">
                        <StackPanel>
                            <!-- 헤더 + 상태 -->
                            <StackPanel Orientation="Horizontal" Margin="2,0,0,6">
                                <TextBlock Text="🎮" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="  관리자 지시" Foreground="#A78BFA"
                                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblCR2Status" Text="  —  대기 중 (작업자 없음)"
                                           Foreground="#6B5E9E" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- 버튼들은 뷰포트 오버레이로 이동됨 -->
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="4" Margin="20,0,20,14">
                        <Rectangle Height="1" Fill="#2D1B5E" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="#818CF8" VerticalAlignment="Center"/>
                            <TextBlock Text="정상 가동 중" Foreground="#9CA3AF"
                                       FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        </ScrollViewer>

        <!-- 하단 상태바 -->
        <Grid Grid.Row="2" Background="#0D1526">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0">
                <TextBlock Text="● LIVE  " Foreground="#22D3EE" FontSize="11"/>
                <TextBlock x:Name="txtDateTime" Foreground="#4B5563" FontSize="11"/>
                <Button x:Name="btnAdsConnect" Content="🔌 ADS 연결"
                        Margin="20,0,0,0" Padding="10,3"
                        Background="#0D2035" BorderBrush="#34D399" BorderThickness="1"
                        Foreground="#34D399" FontSize="11" Cursor="Hand"
                        Click="BtnAdsConnect_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="btnDashboard" Content="📊 센서 대시보드"
                        Margin="20,0,0,0" Padding="10,3"
                        Background="#0D2035" BorderBrush="#22D3EE" BorderThickness="1"
                        Foreground="#22D3EE" FontSize="11" Cursor="Hand"
                        Click="BtnDashboard_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="btnGraph" Content="📈 실시간 그래프"
                        Margin="10,0,0,0" Padding="10,3"
                        Background="#0D2035" BorderBrush="#A78BFA" BorderThickness="1"
                        Foreground="#A78BFA" FontSize="11" Cursor="Hand"
                        Click="BtnGraph_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
