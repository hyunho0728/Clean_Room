<Window x:Class="Clean_Room.SensorDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="실시간 센서 현황"
        Background="#0A0F1E"
        Width="960" Height="720"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <Border Grid.Row="0" Background="#0D1B2A" BorderBrush="#1E3A5F" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#22D3EE" VerticalAlignment="Center"/>
                    <TextBlock Text="실시간 센서 현황" Foreground="#22D3EE"
                               FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtLastUpdate" Foreground="#4B5563"
                               FontSize="11" Margin="20,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="❓" Click="BtnHelp_Click"
                            Background="Transparent" BorderBrush="#374151"
                            Foreground="#9CA3AF" FontSize="13"
                            Width="28" Height="28" Padding="0" Margin="0,0,8,0"
                            Cursor="Hand" ToolTip="센서 위험값 안내"/>
                    <Button Content="📋 알람 이력" Click="BtnHistory_Click"
                            Background="Transparent" BorderBrush="#22D3EE"
                            Foreground="#22D3EE" FontSize="10" Padding="8,4" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CLEAN ROOM 01 -->
        <Border x:Name="headerRoom1" Grid.Row="1" Background="#0A1628" BorderBrush="#1E3A5F"
                BorderThickness="0,0,0,1" Padding="20,6">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#22D3EE" VerticalAlignment="Center"/>
                    <TextBlock Text="CLEAN ROOM  01" Foreground="#22D3EE"
                               FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"/>
                </StackPanel>
                <Button Content="↗ 분리" HorizontalAlignment="Right"
                        Click="BtnDetachRoom1_Click"
                        Background="Transparent" BorderBrush="#22D3EE" BorderThickness="1"
                        Foreground="#22D3EE" FontSize="10" Padding="8,2" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- ISO 등급 배지 R1 -->
        <Border x:Name="isoBar1" Grid.Row="2" Background="#060D1A"
                BorderBrush="#1E3A5F" BorderThickness="0,0,0,1" Padding="24,5">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="ISO 등급" Foreground="#4B5563" FontSize="10"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Border x:Name="isoBadge1" Background="#0D2A1A" CornerRadius="4"
                        BorderBrush="#22D3EE" BorderThickness="1" Padding="8,2" Margin="0,0,10,0">
                    <TextBlock x:Name="txtISO1" Text="ISO 5" Foreground="#22D3EE"
                               FontSize="12" FontWeight="Bold"/>
                </Border>
                <TextBlock Text="목표: ISO 5  |  " Foreground="#374151" FontSize="10"
                           VerticalAlignment="Center"/>
                <TextBlock Text="입자수 " Foreground="#4B5563" FontSize="10" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtParticle1" Text="2,800" Foreground="#9CA3AF"
                           FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text=" 개/m³  |  " Foreground="#4B5563" FontSize="10" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtISOStatus1" Text="✓ 목표 충족" Foreground="#22C55E"
                           FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <StackPanel x:Name="cardsPanel1" Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="16,8"/>

        <!-- CLEAN ROOM 02 -->
        <Border x:Name="headerRoom2" Grid.Row="4" Background="#0A1628" BorderBrush="#1E3A5F"
                BorderThickness="0,1,0,1" Padding="20,6">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#818CF8" VerticalAlignment="Center"/>
                    <TextBlock Text="CLEAN ROOM  02" Foreground="#818CF8"
                               FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"/>
                </StackPanel>
                <Button Content="↗ 분리" HorizontalAlignment="Right"
                        Click="BtnDetachRoom2_Click"
                        Background="Transparent" BorderBrush="#818CF8" BorderThickness="1"
                        Foreground="#818CF8" FontSize="10" Padding="8,2" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- ISO 등급 배지 R2 -->
        <Border x:Name="isoBar2" Grid.Row="5" Background="#060D1A"
                BorderBrush="#1E3A5F" BorderThickness="0,0,0,1" Padding="24,5">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="ISO 등급" Foreground="#4B5563" FontSize="10"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Border x:Name="isoBadge2" Background="#0D2A1A" CornerRadius="4"
                        BorderBrush="#818CF8" BorderThickness="1" Padding="8,2" Margin="0,0,10,0">
                    <TextBlock x:Name="txtISO2" Text="ISO 5" Foreground="#818CF8"
                               FontSize="12" FontWeight="Bold"/>
                </Border>
                <TextBlock Text="목표: ISO 5  |  " Foreground="#374151" FontSize="10"
                           VerticalAlignment="Center"/>
                <TextBlock Text="입자수 " Foreground="#4B5563" FontSize="10" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtParticle2" Text="2,800" Foreground="#9CA3AF"
                           FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text=" 개/m³  |  " Foreground="#4B5563" FontSize="10" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtISOStatus2" Text="✓ 목표 충족" Foreground="#22C55E"
                           FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <StackPanel x:Name="cardsPanel2" Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="16,8"/>

        <!-- 알람 로그 -->
        <Grid Grid.Row="7">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#0D1B2A"
                    BorderBrush="#1E3A5F" BorderThickness="0,1,0,1" Padding="20,6">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#F87171" VerticalAlignment="Center"/>
                    <TextBlock Text="알람 로그" Foreground="#F87171"
                               FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtAlarmCount" Foreground="#4B5563"
                               FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center" Text="(0건)"/>
                    <TextBlock x:Name="txtAlarmPaused" Text="⏸ 일시정지"
                               Foreground="#FBBF24" FontSize="10" FontWeight="SemiBold"
                               Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <Button x:Name="btnResumeAlarm" Content="재개"
                            Click="BtnResumeAlarm_Click"
                            Background="Transparent" BorderBrush="#FBBF24"
                            Foreground="#FBBF24" FontSize="10"
                            Padding="8,2" Margin="6,0,0,0" Cursor="Hand" Visibility="Collapsed"/>
                    <Button x:Name="btnClearAlarms" Content="지우기"
                            Click="BtnClearAlarms_Click"
                            Background="Transparent" BorderBrush="#374151"
                            Foreground="#9CA3AF" FontSize="10"
                            Padding="8,2" Margin="16,0,0,0" Cursor="Hand"/>
                </StackPanel>
            </Border>
            <ScrollViewer Grid.Row="1" x:Name="alarmScroll"
                          VerticalScrollBarVisibility="Auto" Background="#060B14">
                <ItemsControl x:Name="alarmList" Margin="12,6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Margin="0,2" Padding="12,6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#0D1B2A"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEquipmentFault}" Value="True">
                                                <Setter Property="Background" Value="#1A0D1B"/>
                                                <Setter Property="BorderBrush" Value="#7C3AED"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="55"/>
                                        <ColumnDefinition Width="155"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 구역 -->
                                    <TextBlock Grid.Column="0" Text="{Binding Room}"
                                               Foreground="#818CF8" FontSize="11" FontWeight="SemiBold"/>
                                    <!-- 시간 -->
                                    <TextBlock Grid.Column="1" Text="{Binding Timestamp}"
                                               Foreground="#6B7280" FontSize="10" FontFamily="Consolas"/>
                                    <!-- 센서 -->
                                    <TextBlock Grid.Column="2" Text="{Binding Sensor}"
                                               Foreground="#FCD34D" FontSize="11" FontWeight="SemiBold"/>
                                    <!-- 측정값 -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                                        <TextBlock Text="{Binding Value, StringFormat=F2}"
                                                   Foreground="#F87171" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Unit}" Foreground="#9CA3AF"
                                                   FontSize="10" Margin="3,0,0,0" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                    <!-- 상태: 위험/정상 -->
                                    <TextBlock Grid.Column="4" FontSize="10" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text"       Value="✅ 정상"/>
                                                <Setter Property="Foreground" Value="#22C55E"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="위험">
                                                        <Setter Property="Text"       Value="🔴 위험"/>
                                                        <Setter Property="Foreground" Value="#F87171"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- 고장 장비 -->
                                    <TextBlock Grid.Column="5" Text="{Binding EquipmentName}"
                                               Foreground="#C084FC" FontSize="10" FontWeight="SemiBold"/>
                                    <!-- 정비 상태 -->
                                    <TextBlock Grid.Column="6" FontSize="10" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text"       Value=""/>
                                                <Setter Property="Foreground" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MaintenanceStatus}" Value="정비 필요">
                                                        <Setter Property="Text"       Value="🔧 정비 필요"/>
                                                        <Setter Property="Foreground" Value="#FBBF24"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding MaintenanceStatus}" Value="정상">
                                                        <Setter Property="Text"       Value="✅ 정상"/>
                                                        <Setter Property="Foreground" Value="#22C55E"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
